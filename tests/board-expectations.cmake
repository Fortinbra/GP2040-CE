set(reference_targets Pico PicoW Pico2 Pico2W SparkFunProMicroRP2350 PimoroniPicoLipo2XLW PimoroniPicoPlus2 CustomPico)
if(GP2040_BOARD IN_LIST reference_targets)
    set(GP2040_EXPECT_GPIO 30)
    set(GP2040_EXPECT_ADC 5)
    set(GP2040_EXPECT_ADC_BASE 26)
    set(GP2040_EXPECT_FLASH 2097152)
    set(GP2040_EXPECT_WIRELESS 0)
    if(GP2040_BOARD MATCHES "^(Pico2|Pico2W|PimoroniPicoLipo2XLW)$")
        set(GP2040_EXPECT_FLASH 4194304)
    elseif(GP2040_BOARD MATCHES "^(SparkFunProMicroRP2350|PimoroniPicoPlus2)$")
        set(GP2040_EXPECT_FLASH 16777216)
    endif()
    if(GP2040_BOARD MATCHES "^(PimoroniPicoLipo2XLW|PimoroniPicoPlus2)$")
        set(GP2040_EXPECT_GPIO 48)
        set(GP2040_EXPECT_ADC 9)
        set(GP2040_EXPECT_ADC_BASE 40)
    endif()
    if(GP2040_BOARD MATCHES "^(PicoW|Pico2W|PimoroniPicoLipo2XLW)$")
        set(GP2040_EXPECT_WIRELESS 1)
    endif()
endif()